# Neon Serverless PostgreSQL connection strings
# Pooled connection URL (used for normal database queries)
DATABASE_URL="postgresql://username:password@ep-cool-sample-pooler.us-east-2.aws.neon.tech/quiz_db?sslmode=require"

# Direct connection URL (used for migrations and schema introspection)
DIRECT_URL="postgresql://username:password@ep-cool-sample.us-east-2.aws.neon.tech/quiz_db?sslmode=require"

# Authentication secret (at least 32 characters for JOSE HS256 JWT encryption)
JWT_SECRET="online-quiz-platform-secret-key-change-this-in-production-min-32-chars"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

